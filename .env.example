# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME="Chat API"
APP_VERSION="0.1.0"

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chat_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/chat_db

# Redis Settings
REDIS_URL=redis://localhost:6379/0

# Security & JWT Settings
SECRET_KEY=super-secret-key-change-me-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
